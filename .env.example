# Bind to loopback for local development. Set an explicit private or public
# interface only when the Provider is protected by your network policy.
TFO_STORAGE_HOST=127.0.0.1
TFO_STORAGE_PORT=8080

# Use an isolated root. Protocol paths cannot escape this directory.
TFO_STORAGE_ROOT=./storage
TFO_STORAGE_ROOT_NAME=Documents

# This value must match the immutable adapter name registered in Office.
TFO_STORAGE_ADAPTER=customer-storage-a

# Generate a value with: npm run generate-secret
TFO_STORAGE_REQUEST_JWT_SECRET=replace-with-at-least-32-random-utf8-bytes

# Provider-specific safety limit. This is not a protocol-wide Office limit.
TFO_STORAGE_MAX_DOCUMENT_BYTES=314572800

# Optional comma-separated operations intentionally omitted by this Provider.
# Leave empty for the complete reference server.
TFO_STORAGE_UNSUPPORTED_OPERATIONS=
